<?xml version="1.0" encoding="UTF-8"?>
<!--
  Poke Auto Chess ME - Ant build (CLDC 1.0 / MIDP 2.0)
  Usage:  ant clean dist
  Output: build/dist/PokeAutoChess.jar + PokeAutoChess.jad

  The MIDP/CLDC API jars and the preverify tool are auto-detected under
  ${kvem.home}. If detection fails, set them by hand in build.properties.
-->
<project name="PokeAutoChessME" default="dist" basedir=".">

    <property environment="env"/>
    <property file="build.properties"/>
    <property name="kvem.home" value="${env.KVEM_HOME}"/>

    <property name="app.name"    value="PokeAutoChess"/>
    <property name="app.vendor"  value="TriKhai"/>
    <property name="app.version" value="1.3.0"/>
    <property name="midlet.class" value="pac.PacMidlet"/>
    <property name="midlet.icon" value="/icon.png"/>

    <property name="src.dir"     value="src"/>
    <property name="res.dir"     value="res"/>
    <property name="build.dir"   value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="pre.dir"     value="${build.dir}/preverified"/>
    <property name="dist.dir"    value="${build.dir}/dist"/>
    <property name="test.dir"    value="test"/>
    <property name="test.classes.dir" value="${build.dir}/testclasses"/>

    <!-- ============ locate API jars ============ -->
    <target name="find-libs">
        <!-- explicit override wins: -Dcldc.jar=... -Dmidp.jar=... -Dpreverify.exe=... -->
        <path id="found.cldc">
            <fileset dir="${kvem.home}" erroronmissingdir="false">
                <include name="**/cldcapi11.jar"/>
                <include name="**/cldcapi10.jar"/>
                <include name="**/cldc_1.1.jar"/>
                <include name="**/cldc_1.0.jar"/>
            </fileset>
        </path>
        <path id="found.midp">
            <fileset dir="${kvem.home}" erroronmissingdir="false">
                <include name="**/midpapi21.jar"/>
                <include name="**/midpapi20.jar"/>
                <include name="**/midp_2.1.jar"/>
                <include name="**/midp_2.0.jar"/>
            </fileset>
        </path>
        <path id="found.preverify">
            <fileset dir="${kvem.home}" erroronmissingdir="false">
                <include name="**/preverify.exe"/>
                <include name="**/preverify1.1.exe"/>
                <include name="**/preverify"/>
            </fileset>
        </path>

        <!-- pick the first hit of each -->
        <pathconvert property="cldc.jar" setonempty="false" pathsep="${path.separator}" refid="found.cldc"/>
        <pathconvert property="midp.jar" setonempty="false" pathsep="${path.separator}" refid="found.midp"/>
        <pathconvert property="preverify.exe" setonempty="false" refid="found.preverify"/>

        <fail message="Could not find CLDC/MIDP API jars under KVEM_HOME=${kvem.home}. Set cldc.jar / midp.jar in build.properties.">
            <condition><not><and><isset property="cldc.jar"/><isset property="midp.jar"/></and></not></condition>
        </fail>
        <echo message="cldc.jar      = ${cldc.jar}"/>
        <echo message="midp.jar      = ${midp.jar}"/>
        <echo message="preverify.exe = ${preverify.exe}"/>

        <path id="boot.path">
            <pathelement path="${cldc.jar}"/>
            <pathelement path="${midp.jar}"/>
        </path>
    </target>

    <!-- ============ build ============ -->
    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="compile" depends="find-libs">
        <mkdir dir="${classes.dir}"/>
        <!-- old source/target level: the JDK 8 javac still supports 1.3 and it keeps the
             bytecode free of newer-Java constructs the CLDC verifier cannot digest -->
        <javac srcdir="${src.dir}" destdir="${classes.dir}" source="1.3" target="1.3"
               debug="false" optimize="true" includeantruntime="false"
               bootclasspathref="boot.path" encoding="UTF-8" nowarn="true"/>
    </target>

    <!-- Desktop regression suite. Tests pure game logic and are never packaged. -->
    <target name="test" depends="compile">
        <mkdir dir="${test.classes.dir}"/>
        <javac srcdir="${test.dir}" destdir="${test.classes.dir}" source="1.3" target="1.3"
               debug="false" includeantruntime="true" encoding="UTF-8" nowarn="true">
            <classpath>
                <pathelement location="${classes.dir}"/>
                <path refid="boot.path"/>
            </classpath>
        </javac>
        <java classname="pac.CombatSmokeTest" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${classes.dir}"/>
                <pathelement location="${test.classes.dir}"/>
                <path refid="boot.path"/>
            </classpath>
        </java>
    </target>

    <target name="preverify" unless="skip.preverify" depends="compile">
        <mkdir dir="${pre.dir}"/>
        <fail message="preverify tool not found under KVEM_HOME. Set preverify.exe in build.properties (or -Dskip.preverify=true to skip)."
              unless="preverify.exe"/>
        <exec executable="${preverify.exe}" failonerror="true">
            <arg value="-classpath"/>
            <arg value="${cldc.jar}${path.separator}${midp.jar}"/>
            <arg value="-d"/>
            <arg value="${pre.dir}"/>
            <arg value="${classes.dir}"/>
        </exec>
    </target>

    <target name="preverify-skip" if="skip.preverify" depends="compile">
        <mkdir dir="${pre.dir}"/>
        <copy todir="${pre.dir}"><fileset dir="${classes.dir}"/></copy>
    </target>

    <target name="jar" depends="preverify,preverify-skip">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/${app.name}-Full.jar" basedir="${pre.dir}" compress="true">
            <fileset dir="${res.dir}" erroronmissingdir="false"/>
            <manifest>
                <attribute name="MIDlet-Name"       value="${app.name}"/>
                <attribute name="MIDlet-Vendor"     value="${app.vendor}"/>
                <attribute name="MIDlet-Version"    value="${app.version}"/>
                <attribute name="MIDlet-1"          value="${app.name},${midlet.icon},${midlet.class}"/>
                <attribute name="MIDlet-Icon"       value="${midlet.icon}"/>
                <attribute name="MicroEdition-Configuration" value="CLDC-1.0"/>
                <attribute name="MicroEdition-Profile"       value="MIDP-2.0"/>
            </manifest>
        </jar>
    </target>

    <target name="jar-lite" depends="preverify,preverify-skip">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/${app.name}-Lite.jar" basedir="${pre.dir}" compress="true">
            <fileset dir="${res.dir}" erroronmissingdir="false"><exclude name="raw/**"/><exclude name="sfx/**"/></fileset>
            <manifest>
                <attribute name="MIDlet-Name" value="${app.name} Lite"/><attribute name="MIDlet-Vendor" value="${app.vendor}"/><attribute name="MIDlet-Version" value="${app.version}"/>
                <attribute name="MIDlet-1" value="${app.name} Lite,${midlet.icon},${midlet.class}"/><attribute name="MIDlet-Icon" value="${midlet.icon}"/>
                <attribute name="MicroEdition-Configuration" value="CLDC-1.0"/><attribute name="MicroEdition-Profile" value="MIDP-2.0"/>
            </manifest>
        </jar>
    </target>

    <target name="dist" depends="jar">
        <length file="${dist.dir}/${app.name}-Full.jar" property="jar.size"/>
        <echo file="${dist.dir}/${app.name}-Full.jad">MIDlet-Name: ${app.name}
MIDlet-Vendor: ${app.vendor}
MIDlet-Version: ${app.version}
MIDlet-1: ${app.name},${midlet.icon},${midlet.class}
MIDlet-Icon: ${midlet.icon}
MIDlet-Jar-URL: ${app.name}-Full.jar
MIDlet-Jar-Size: ${jar.size}
MicroEdition-Configuration: CLDC-1.0
MicroEdition-Profile: MIDP-2.0
</echo>
        <echo message="Built ${dist.dir}/${app.name}-Full.jar (${jar.size} bytes)"/>
    </target>

    <target name="dist-lite" depends="jar-lite">
        <length file="${dist.dir}/${app.name}-Lite.jar" property="lite.jar.size"/>
        <echo file="${dist.dir}/${app.name}-Lite.jad">MIDlet-Name: ${app.name} Lite
MIDlet-Vendor: ${app.vendor}
MIDlet-Version: ${app.version}
MIDlet-1: ${app.name} Lite,${midlet.icon},${midlet.class}
MIDlet-Icon: ${midlet.icon}
MIDlet-Jar-URL: ${app.name}-Lite.jar
MIDlet-Jar-Size: ${lite.jar.size}
MicroEdition-Configuration: CLDC-1.0
MicroEdition-Profile: MIDP-2.0
</echo>
        <echo message="Built ${dist.dir}/${app.name}-Lite.jar (${lite.jar.size} bytes)"/>
    </target>

    <target name="dist-all" depends="dist,dist-lite"/>
</project>
